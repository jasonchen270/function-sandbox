#!/bin/sh
# override <kind> <name> [key]
#
#   kind   adjust | render
#   name   a unique symbol/file name for this override
#   key    adjust: the slot, e.g. "100-tax" (numeric prefix sets apply order)
#          render: ignored (always key "default")
#
# Scaffolds a new override as its own file under overrides/, stamped with the
# current local time in milliseconds as its recency. A freshly scaffolded file
# is therefore "more recent" than older ones, so it wins its key. core/ is never
# touched. Edit the body, then ./build.sh and restart.
set -e
cd "$(dirname "$0")"

kind="$1"
name="$2"
key="$3"
if [ -z "$kind" ] || [ -z "$name" ]; then
    echo "usage: ./override <adjust|render> <name> [key]" >&2
    exit 1
fi

recency="$(python3 -c 'import time; print(int(time.time()*1000))')"
out="overrides/${name}.cpp"
if [ -e "$out" ]; then
    echo "error: $out already exists" >&2
    exit 1
fi
mkdir -p overrides

case "$kind" in
adjust)
    [ -z "$key" ] && { echo "adjust needs a key, e.g. 100-tax" >&2; exit 1; }
    cat > "$out" <<EOF
// Adjustment override "$name" for key "$key" (recency $recency).
#include "../core/pricing.h"

namespace {

double ${name}(double total, const Cart& cart) {
    // TODO: your change. Starts as identity (returns total unchanged).
    return total;
}

const bool _registered = pricing::adjustments().set("$key", ${recency}LL, ${name});

} // namespace
EOF
    ;;
render)
    cat > "$out" <<EOF
// Render override "$name" for key "default" (recency $recency).
#include <string>

#include "../core/receipt.h"

namespace {

std::string ${name}(const Cart& cart, double total) {
    // TODO: your change. Return the receipt text.
    return "subtotal " + std::to_string(cart.subtotal) + " total " + std::to_string(total);
}

const bool _registered = receipt::renderer().set("default", ${recency}LL, ${name});

} // namespace
EOF
    ;;
*)
    echo "unknown kind: $kind (use adjust or render)" >&2
    exit 1
    ;;
esac

echo "created $out  (kind=$kind recency=$recency) -- edit the body, then ./build.sh"
